.DS_Store
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
*.ipynb.legacy
notebooks/test.ipynb

# Local credentials and private keys must never be committed.
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json

# Raw public-source downloads are reproducible and too large for ordinary Git.
data/raw/

# Generated datasets and databases are local build artifacts.
data/processed/*
!data/processed/.gitkeep
data/local/
data/training/
*.sqlite
*.sqlite3

# Generated quality reports.
reports/*.json
reports/*.csv
reports/*.html
!reports/.gitkeep
